# Domain pointing at this VPS (Caddy obtains the TLS cert automatically)
CHANNEL_DOMAIN=channel.example.com

# Root credential: grants the management tools (create_channel, rotate_token,
# ...). Generate one:  python3 -c "import secrets; print('cca_'+secrets.token_urlsafe(32))"
# Shorter than 32 characters still starts, with a warning in the log.
AI_AGENT_CHANNEL_ADMIN_TOKEN=

# Optional. Comma-separated Host values the server answers to; Origin is
# derived from them. Turns on DNS-rebinding protection for every route
# except /healthz. Unset = no Host check (a warning is logged at startup).
# docker-compose.yml defaults it to CHANNEL_DOMAIN. Add 127.0.0.1:* if you
# also call the loopback port from the host.
#AI_AGENT_CHANNEL_ALLOWED_HOSTS=channel.example.com

# Optional. Days a board viewing key stays valid (default 30; 1..3650, an
# invalid value logs a warning and uses the default).
#AI_AGENT_CHANNEL_VIEW_KEY_TTL_DAYS=30

# Optional. Believe X-Forwarded-Proto from any peer, not only a
# loopback/private one (the default suits a proxy on the same host/network).
# Also lets uvicorn take the client address from X-Forwarded-For from any
# peer (otherwise only from loopback). Set it only when nothing but your
# proxy can reach the container.
#AI_AGENT_CHANNEL_TRUST_PROXY=1

# Optional. Concurrent held /status?wait=N requests before 429 (default 64),
# and how many of them one token may hold (default 8).
#AI_AGENT_CHANNEL_STATUS_MAX_WAITERS=64
#AI_AGENT_CHANNEL_STATUS_MAX_WAITERS_PER_TOKEN=8
